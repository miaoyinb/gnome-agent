id: gnome-agent.example_workflow
name: Gnome Agent Example Workflow
version: "1.0.0"
description: Example agent-owned workflow for Gnome Agent. Rename this file to .yaml to publish it.
inputs:
  required:
    - input_data
  optional: []
execution:
  mode: sequential
  max_concurrency: 1
  on_error: fail_fast
steps:
  - id: run_primary_skill
    skill_id: fix-this-later
    is_final: true
    params:
      input_data:
        from: input.input_data
outputs:
  final:
    from: step.run_primary_skill.result
metadata:
  requires_approval: false
  estimated_duration_seconds: 30
  owner: gnome-agent
ui:
  category: Gnome Agent
  display_name: Gnome Agent Example Workflow
  summary: Example workflow that invokes the primary Gnome Agent skill.
